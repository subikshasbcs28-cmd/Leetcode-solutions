#include <stdlib.h>
#include <string.h>
#include <stdio.h>

char* countAndSay(int n) {
    // Initial string base case for n = 1
    char* current = (char*)malloc(2 * sizeof(char));
    strcpy(current, "1");
    
    if (n == 1) {
        return current;
    }
    
    // Iteratively generate sequences from 2 to n
    for (int i = 2; i <= n; i++) {
        // Allocate a temporary buffer for the next sequence string
        // 5000 bytes is safe as the string length for n=30 fits well within this bound
        int capacity = 5000;
        char* next_str = (char*)malloc(capacity * sizeof(char));
        int next_idx = 0;
        
        int len = strlen(current);
        int j = 0;
        
        while (j < len) {
            char digit = current[j];
            int count = 0;
            
            // Count consecutive occurrences of the same digit
            while (j < len && current[j] == digit) {
                count++;
                j++;
            }
            
            // Append the count and the digit to the next sequence buffer
            // sprintf returns the number of characters written
            next_idx += sprintf(&next_str[next_idx], "%d%c", count, digit);
        }
        
        // Free the old sequence buffer and update it to point to the new one
        free(current);
        current = next_str;
    }
    
    return current;
}
