#include <string.h>
#include <stdlib.h>
#include <stdbool.h>

// Helper function to check if two words differ by exactly one character
bool isNeighbor(const char* word1, const char* word2, int len) {
    int diff = 0;
    for (int i = 0; i < len; i++) {
        if (word1[i] != word2[i]) {
            diff++;
            if (diff > 1) return false;
        }
    }
    return diff == 1;
}

int ladderLength(char* beginWord, char* endWord, char** wordList, int wordListSize) {
    int wordLen = strlen(beginWord);
    
    // Check if endWord is even in the wordList
    int endIdx = -1;
    for (int i = 0; i < wordListSize; i++) {
        if (strcmp(wordList[i], endWord) == 0) {
            endIdx = i;
            break;
        }
    }
    // If target endWord is missing, no valid sequence exists
    if (endIdx == -1) return 0;
    
    // Visited tracking array: 0 = unvisited, 1 = visited
    int* visited = (int*)calloc(wordListSize, sizeof(int));
    
    // BFS Queue to store the indexes of the words in wordList
    int* queue = (int*)malloc(wordListSize * sizeof(int));
    int head = 0;
    int tail = 0;
    
    // Initialize BFS by finding all words that are 1-letter away from beginWord
    for (int i = 0; i < wordListSize; i++) {
        if (isNeighbor(beginWord, wordList[i], wordLen)) {
            queue[tail++] = i;
            visited[i] = 1;
        }
    }
    
    int depth = 1; // 1 represents the initial layer (beginWord)
    
    // Standard level-by-level BFS traversal
    while (head < tail) {
        depth++;
        int currentLevelSize = tail - head;
        
        for (int i = 0; i < currentLevelSize; i++) {
            int currIdx = queue[head++];
            
            // If we match the endWord index, return total sequence length
            if (currIdx == endIdx) {
                free(visited);
                free(queue);
                return depth;
            }
            
            // Find unvisited neighbors in the wordList
            for (int j = 0; j < wordListSize; j++) {
                if (!visited[j] && isNeighbor(wordList[currIdx], wordList[j], wordLen)) {
                    queue[tail++] = j;
                    visited[j] = 1;
                }
            }
        }
    }
    
    // Cleanup memory if no path is found
    free(visited);
    free(queue);
    return 0;
}
